<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>IPhonePhotos.Core</RootNamespace>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FaceAiSharp" Version="0.6.38" />
    <PackageReference Include="FaceAiSharp.Models.ArcFace.LResNet100E-IR-int8" Version="0.20230419.1" />
    <PackageReference Include="FaceAiSharp.Models.OpenVino.open-closed-eye-0001" Version="0.20220116.2" />
    <PackageReference Include="FaceAiSharp.Models.Scrfd.2dot5g_kps" Version="0.20230205.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <Using Include="System.IO" />
    <!-- Técnica WPD/MTP -->
    <PackageReference Include="MediaDevices" Version="2.0.0" />
    <!-- Técnica AFC (envoltorio de libimobiledevice con sus bibliotecas nativas de Windows) -->
    <PackageReference Include="iMobileDevice-net" Version="1.3.17" />
    <!-- Técnica copia de seguridad: lectura de Manifest.db -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Manifiesto de reanudación -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
