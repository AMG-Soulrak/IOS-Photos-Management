<Window x:Class="IPhonePhotos.App.OrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organizar" Height="620" Width="700" MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" ShowInTaskbar="False">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                       FontFamily="{StaticResource UiDisplayFont}"/>
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Carpeta -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="CARPETA CON LAS FOTOS" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" AutomationProperties.Name="Carpeta" TextChanged="OnFolderChanged" AutomationProperties.AutomationId="OrgFolderBox"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Cambiar…" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="OnBrowse" AutomationProperties.AutomationId="OrgBrowseButton"/>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource SectionFooter}"
                       Text="Puede ser cualquier carpeta con fotos ya descargadas: no hace falta el iPhone."/>
        </StackPanel>

        <Button x:Name="CalcButton" Grid.Row="2" Content="1. Ver qué se haría (simulación)" HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButton}" Click="OnCalculate" AutomationProperties.AutomationId="OrgCalcButton"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="PlanText" TextWrapping="Wrap" FontWeight="SemiBold"
                               Text="Pulsa «Ver qué se haría». Todavía no se ha tocado nada."
                               AutomationProperties.AutomationId="OrgPlanText"/>
                    <ProgressBar x:Name="Bar" Margin="0,12,0,8" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="DetailText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NotesText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="OrgResultText"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Cerrar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="OnClose" AutomationProperties.AutomationId="OrgCloseButton"/>
            <Button x:Name="ApplyButton" Content="2. Aplicar" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="OnApply" AutomationProperties.AutomationId="OrgApplyButton"/>
        </StackPanel>
    </Grid>
</Window>
