<UserControl x:Class="IPhonePhotos.App.AlbumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="14">
    <UserControl.Resources>
        <!-- Fila de lista con esquinas redondeadas, como en la barra lateral -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="12,8" Margin="0,1,6,1" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource NavSelected}"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Álbum" Style="{StaticResource LargeTitle}"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0"
                           Text="Cargando…" AutomationProperties.AutomationId="AlbumStatus" AutomationProperties.LiveSetting="Polite"/>
                <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="SelectAllButton" Content="Seleccionar todas" Style="{StaticResource TextButton}" Padding="0,3,12,3"
                            Click="OnSelectAll" AutomationProperties.AutomationId="AlbumSelectAll"/>
                    <Button Content="Quitar selección" Style="{StaticResource TextButton}" Padding="0,3,12,3"
                            Click="OnSelectNone" AutomationProperties.AutomationId="AlbumSelectNone"/>
                    <Button x:Name="DiscardButton" Content="Descartar las seleccionadas…" Style="{StaticResource TextButton}" Padding="0,3,12,3"
                            Click="OnDiscardSelected" AutomationProperties.AutomationId="AlbumDiscard"
                            ToolTip="Las aparta a la carpeta «_Descartadas» (no se borran)"/>
                </WrapPanel>
            </StackPanel>
            <ComboBox x:Name="AlbumFilter" AutomationProperties.Name="Filtrar fotos" Grid.Column="1" VerticalAlignment="Top" Width="170" Margin="0,0,8,0" SelectedIndex="0"
                      ToolTip="Filtra las fotos según estén o no en un álbum" AutomationProperties.AutomationId="AlbumFilter">
                <ComboBoxItem Content="Todas las fotos"/>
                <ComboBoxItem Content="Con álbum"/>
                <ComboBoxItem Content="Sin álbum asociado"/>
            </ComboBox>
            <Button x:Name="ByDateButton" Grid.Column="2" Content="Por fecha" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}"
                    Click="OnByDate" AutomationProperties.AutomationId="AlbumByDate"/>
            <Button x:Name="ByPlaceButton" Grid.Column="3" Content="Por lugar" VerticalAlignment="Top" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="OnByPlace" AutomationProperties.AutomationId="AlbumByPlace"/>
        </Grid>

        <Border x:Name="PlacesBanner" Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                           Text="Para agrupar por lugar hace falta una lista de ciudades (≈2 MB, de geonames.org, licencia CC BY 4.0). Se descarga una sola vez; tus fotos y coordenadas no salen del PC."/>
                <Button x:Name="DownloadPlacesButton" Content="Descargar nombres de lugares" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="OnDownloadPlaces" AutomationProperties.AutomationId="AlbumDownloadPlaces"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="GroupList" AutomationProperties.Name="Grupos" SelectionChanged="OnGroupSelected" ItemContainerStyle="{StaticResource RowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         AutomationProperties.AutomationId="AlbumGroupList"/>

                <!-- Álbumes propios: carpetas reales; las fotos se arrastran hasta aquí -->
                <!-- Este panel se saca de aquí y la ventana principal lo coloca bajo «Álbum» en la barra lateral (AlbumsPanel) -->
                <Border x:Name="AlbumsBox" Grid.Row="1">
                    <StackPanel>
                        <Button Content="+ Nuevo álbum" HorizontalAlignment="Left" Style="{StaticResource TextButton}" Padding="12,3"
                                Click="OnNewAlbum" AutomationProperties.AutomationId="AlbumNew"/>
                        <ListBox x:Name="AlbumList" AutomationProperties.Name="Álbumes" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnAlbumSelected" AllowDrop="True"
                                 DragOver="OnAlbumDragOver" DragLeave="OnAlbumDragLeave" Drop="OnAlbumDrop"
                                 PreviewMouseRightButtonDown="OnAlbumRightClick" AutomationProperties.AutomationId="AlbumList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="AlbumHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="12,4,8,0"
                                   Text="Crea un álbum y arrastra fotos hasta él."/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Teclado: Tab entra en las miniaturas, las flechas se mueven entre ellas, Espacio marca y Intro abre. -->
                    <ItemsControl x:Name="Thumbs" AutomationProperties.Name="Fotos"
                                  KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Height="150" Margin="3" Background="#10808080" CornerRadius="6" ClipToBounds="True"
                                        BorderThickness="3" BorderBrush="{Binding Outline}"
                                        ToolTip="{Binding Tip}" Cursor="Hand"
                                        Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" KeyDown="OnThumbKey"
                                        AutomationProperties.Name="{Binding A11yName}"
                                        PreviewMouseLeftButtonDown="OnThumbDown" PreviewMouseMove="OnThumbMove"
                                        PreviewMouseLeftButtonUp="OnThumbUp" PreviewMouseRightButtonDown="OnThumbRightClick">
                                    <Grid>
                                        <Image Source="{Binding Source}" Stretch="UniformToFill" AutomationProperties.Name="{Binding A11yName}"/>
                                        <Border Background="{Binding WhereBack}" VerticalAlignment="Bottom" Padding="6,2" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Where}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Visibility="{Binding LiveVisibility}" Background="#99000000" CornerRadius="4" Padding="5,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                            <TextBlock Text="LIVE" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="MoreButton" Content="Mostrar más" HorizontalAlignment="Left" Margin="3,8,0,8"
                            Style="{StaticResource SecondaryButton}" Click="OnMore" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ProgressBar x:Name="Bar" Grid.Row="3" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>
