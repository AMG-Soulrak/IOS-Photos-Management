<Window x:Class="IPhonePhotos.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IOS Photos" Icon="Assets/logo.png" Height="860" Width="1240" MinHeight="700" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Elemento de la barra lateral que se queda marcado (páginas) -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,1">
                            <Border x:Name="bg" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="14,0" Height="38">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NavSelected}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acción de la barra lateral (abre una ventana; no se queda marcada) -->
        <Style x:Key="NavAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,1">
                            <Border x:Name="bg" CornerRadius="6" Background="Transparent"/>
                            <StackPanel Orientation="Horizontal" Margin="14,0" Height="38">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource NavSelected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="14,18,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral, como la de Dispositivos Apple -->
        <DockPanel Margin="12,16,6,12">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Style="{StaticResource NavAction}" Tag="&#xE896;" Content="Descargar del iPhone…" Click="OnDownload"
                        AutomationProperties.AutomationId="ShellDownload"/>
                <Button Style="{StaticResource NavAction}" Tag="&#xE793;" Content="Modo claro / oscuro" Click="OnToggleTheme"
                        AutomationProperties.AutomationId="ShellTheme"/>
                <Button Style="{StaticResource NavAction}" Tag="&#xE8B7;" Content="Cambiar carpeta de fotos…" Click="OnChangeFolder"
                        AutomationProperties.AutomationId="ShellFolder"/>
            </StackPanel>
            <!-- Si hay muchos álbumes, la barra lateral entera se desplaza con la rueda, sin barras a la vista -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Cabecera: como el dispositivo en la app de Apple -->
                <StackPanel Orientation="Horizontal" Margin="8,0,0,10">
                    <Image Source="Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="IOS Photos" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FolderText" FontSize="12" Foreground="{DynamicResource Muted}" MaxWidth="170"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ShellFolderText"/>
                    </StackPanel>
                </StackPanel>

                <RadioButton x:Name="NavAlbum" Style="{StaticResource NavItem}" Tag="&#xE91B;" Content="Álbum" GroupName="nav"
                             IsChecked="True" Checked="OnNavChanged" AutomationProperties.AutomationId="NavAlbum"/>
                <!-- Álbumes propios: submenú de «Álbum» (el panel lo aporta AlbumView) -->
                <ContentControl x:Name="AlbumsHost" Margin="30,0,0,4"/>
                <RadioButton x:Name="NavDups" Style="{StaticResource NavItem}" Tag="&#xE8C8;" Content="Fotos repetidas" GroupName="nav"
                             Checked="OnNavChanged" AutomationProperties.AutomationId="NavDuplicates"/>

                <RadioButton x:Name="NavPeople" Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="Personas" GroupName="nav"
                             Checked="OnNavChanged" AutomationProperties.AutomationId="NavPeople"/>

                <RadioButton x:Name="NavDiscard" Style="{StaticResource NavItem}" Tag="&#xE74D;" Content="Descartar capturas…" GroupName="nav"
                             Checked="OnNavChanged" AutomationProperties.AutomationId="NavDiscard"/>

                <TextBlock Text="Organizar la carpeta" Style="{StaticResource NavHeader}"/>
                <Button Style="{StaticResource NavAction}" Tag="&#xE787;" Content="Por año y mes…" Click="OnOrganizeDate"/>
                <Button Style="{StaticResource NavAction}" Tag="&#xE81D;" Content="Por lugar…" Click="OnOrganizePlace"/>
                <Button Style="{StaticResource NavAction}" Tag="&#xE714;" Content="Limpiar Live Photos…" Click="OnLivePhotos"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Contenido: una tarjeta blanca sobre el fondo, como en Windows 11 -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,12,12,12" Padding="24,20,24,16">
            <ContentControl x:Name="Host"/>
        </Border>
    </Grid>
</Window>
