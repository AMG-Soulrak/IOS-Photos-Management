<Window x:Class="IPhonePhotos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IOS Photos · Descargar del iPhone" Icon="Assets/logo.png" Height="920" Width="980" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título grande, como en iOS -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Descargar del iPhone" Style="{StaticResource LargeTitle}"/>
            <TextBlock Text="Copia todas las fotos y vídeos del iPhone o iPad. Si se corta, continúa justo donde se quedó."
                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Aviso del controlador de Apple -->
        <Border x:Name="DriverBanner" Grid.Row="1" Visibility="Collapsed" Background="#FFF3E0"
                CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
            <TextBlock x:Name="DriverText" TextWrapping="Wrap" Foreground="#8A4B00"/>
        </Border>

        <!-- Grupos de ajustes -->
        <StackPanel Grid.Row="2">
            <!-- Dispositivo -->
            <TextBlock Text="DISPOSITIVO" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DeviceCombo" AutomationProperties.Name="Dispositivo" DisplayMemberPath="DisplayName"
                              SelectionChanged="OnSelectionChanged" AutomationProperties.AutomationId="DeviceCombo"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="Buscar de nuevo" Margin="8,0,0,0"
                            Style="{StaticResource TextButton}" Click="OnRefresh" AutomationProperties.AutomationId="RefreshButton"/>
                </Grid>
            </Border>
            <TextBlock x:Name="DeviceHint" Style="{StaticResource SectionFooter}" AutomationProperties.AutomationId="DeviceHint"/>

            <!-- Destino -->
            <TextBlock Text="DESTINO" Style="{StaticResource SectionHeader}" Margin="16,16,0,6"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="16,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Guardar en" VerticalAlignment="Center"/>
                        <TextBox x:Name="DestBox" AutomationProperties.Name="Guardar en" Grid.Column="1" TextChanged="OnSelectionChanged"
                                 AutomationProperties.AutomationId="DestBox"/>
                        <Button Grid.Column="2" Content="Examinar…" Margin="8,0,0,0" Style="{StaticResource TextButton}"
                                Click="OnBrowse" AutomationProperties.AutomationId="BrowseButton"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <Grid Margin="16,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Si ya hay fotos" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AdoptCombo" AutomationProperties.Name="Si ya hay fotos" Grid.Column="1" SelectedIndex="0" AutomationProperties.AutomationId="AdoptCombo">
                            <ComboBoxItem Tag="Fast" Content="No descargar las que tengan el mismo nombre, tamaño y fecha (rápido; quedan «adoptadas, sin verificar»)"/>
                            <ComboBoxItem Tag="Deep" Content="Reutilizar solo si el contenido es idéntico al del iPhone (lento, cuenta como verificado)"/>
                            <ComboBoxItem Tag="None" Content="No reutilizar: copiar todo de nuevo con otro nombre si hace falta"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Conexión -->
            <TextBlock Text="CONEXIÓN Y ORDEN" Style="{StaticResource SectionHeader}" Margin="16,16,0,6"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="16,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cómo conectar" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TechniqueCombo" AutomationProperties.Name="Cómo conectar" Grid.Column="1" SelectedIndex="0" AutomationProperties.AutomationId="TechniqueCombo">
                            <ComboBoxItem Tag="" Content="Automático: prueba las técnicas y usa la mejor; si una falla pasa a la siguiente"/>
                            <ComboBoxItem Tag="wpd" Content="Solo WPD (como el Explorador de Windows)"/>
                            <ComboBoxItem Tag="afc" Content="Solo AFC (acceso directo al iPhone, solo lectura)"/>
                            <ComboBoxItem Tag="backup" Content="Solo copia de seguridad de Apple Devices/iTunes"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <CheckBox x:Name="SnapshotCheck" IsChecked="True" Margin="16,11,16,11"
                              Content="Si ninguna técnica en vivo funciona, permitir leer la última copia de seguridad (foto fija: puede faltar lo más reciente)"
                              AutomationProperties.AutomationId="SnapshotCheck"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <CheckBox x:Name="NewFolderCheck" IsChecked="True" Margin="16,11,16,11"
                              Content="Guardar las fotos nuevas en la carpeta «Nuevos», para repartirlas luego en álbumes. Las que ya tienes, estén en la carpeta o el álbum que estén, no se vuelven a descargar"
                              AutomationProperties.AutomationId="NewFolderCheck"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <CheckBox x:Name="OrganizeCheck" Margin="16,11,16,11"
                              Content="Si no usas «Nuevos»: guardar las fotos nuevas en carpetas Año\Mes (p. ej. 2024\03) según su fecha de captura, en vez de DCIM\100APPLE"
                              AutomationProperties.AutomationId="OrganizeCheck"/>
                    <Rectangle Style="{StaticResource Separator}"/>
                    <CheckBox x:Name="JpgCheck" Margin="16,11,16,11"
                              Content="Guardar también una copia JPG de cada foto HEIC (en la carpeta «… (JPG)» junto a la de destino; los originales no se tocan)"
                              AutomationProperties.AutomationId="JpgCheck"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Acciones -->
        <WrapPanel Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="DownloadButton" Content="Descargar / Reanudar" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,8" Click="OnDownload" AutomationProperties.AutomationId="DownloadButton"/>
            <Button x:Name="StopButton" Content="Detener" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                    IsEnabled="False" Click="OnStop" AutomationProperties.AutomationId="StopButton"/>
            <Button x:Name="CompareButton" Content="Ver qué falta" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnCompare" AutomationProperties.AutomationId="CompareButton"/>
            <Button x:Name="VerifyButton" Content="Verificar copias" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnVerify" AutomationProperties.AutomationId="VerifyButton"/>
            <Border Style="{StaticResource Card}" Padding="14,4" Margin="0,0,8,8" VerticalAlignment="Stretch">
                <CheckBox x:Name="VerifyDeepCheck" Content="a fondo (relee también el iPhone)" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="VerifyDeepCheck"/>
            </Border>
            <Button x:Name="OpenButton" Content="Abrir carpeta" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnOpenFolder" AutomationProperties.AutomationId="OpenButton"/>
            <Button Content="Ayuda de conexión" Style="{StaticResource TextButton}" Margin="0,0,0,8" Click="OnConnectionHelp"
                    AutomationProperties.Name="Ayuda de conexión: conectar tu iPhone o iPad" AutomationProperties.AutomationId="HelpButton"/>
        </WrapPanel>

        <!-- Progreso -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18,16" Margin="0,6,0,16">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Conecta el iPhone con el cable, desbloquéalo y pulsa «Confiar»."
                           FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="Bar" Margin="0,12,0,10" Minimum="0" Maximum="100"
                             AutomationProperties.AutomationId="ProgressBar" AutomationProperties.Name="Progreso de la copia"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource AutoHide}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="DetailText"/>
                <TextBlock x:Name="CurrentText" Style="{StaticResource AutoHide}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource AutoHide}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SummaryText"/>
                <!-- Tras la copia: qué hacer ahora -->
                <WrapPanel x:Name="AfterPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button Content="Verificar a fondo ahora" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnVerifyDeepNow"
                            AutomationProperties.AutomationId="VerifyDeepNow"/>
                    <Button Content="Abrir carpeta" Style="{StaticResource SecondaryButton}" Click="OnOpenFolder"/>
                </WrapPanel>
                <!-- No copiados, con su motivo y reintento -->
                <StackPanel x:Name="FailedPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="FailedTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Reintentar todos" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="OnRetryAllFailed"
                                AutomationProperties.AutomationId="RetryAllFailed"/>
                    </Grid>
                    <ItemsControl x:Name="FailedList" Margin="0,6,0,0" AutomationProperties.Name="Archivos no copiados">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Reintentar" Style="{StaticResource TextButton}" Click="OnRetryOneFailed"
                                            AutomationProperties.Name="{Binding RetryName}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Error en lenguaje llano: una causa, una acción, Reintentar; lo técnico en «Detalles» -->
        <Border x:Name="ErrorPanel" Grid.Row="5" Visibility="Collapsed" Background="{DynamicResource DangerTint}" CornerRadius="12"
                Padding="18,14" Margin="0,0,0,16" AutomationProperties.AutomationId="ErrorPanel">
            <StackPanel>
                <TextBlock x:Name="ErrorCause" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorAction" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="ErrorRetry" Content="Reintentar" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnErrorRetry"
                            AutomationProperties.AutomationId="ErrorRetry"/>
                    <Button Content="Ayuda de conexión" Style="{StaticResource SecondaryButton}" Click="OnErrorHelp"
                            AutomationProperties.AutomationId="ErrorHelp"/>
                </WrapPanel>
                <Expander Header="Detalles" Margin="0,10,0,0" AutomationProperties.Name="Detalles técnicos del error">
                    <TextBox x:Name="ErrorDetails" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                             AutomationProperties.Name="Detalles técnicos"/>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Registro -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="REGISTRO" Style="{StaticResource SectionHeader}"/>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Height="170">
                <ListBox x:Name="LogList" AutomationProperties.Name="Registro" FontFamily="Consolas" FontSize="12" AutomationProperties.AutomationId="LogList"/>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
