<Window x:Class="IPhonePhotos.App.PhotoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foto" Height="860" Width="1100" MinHeight="480" MinWidth="640" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" Background="#141414" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14" PreviewKeyDown="OnKey">
    <!-- Fondo oscuro fijo en los dos modos: la foto destaca y el texto blanco/gris claro da contraste ≥ 4,5:1. -->
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="OnWheel" Focusable="False">
            <Image x:Name="Big" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="PreviewImage"/>
        </ScrollViewer>
        <TextBlock x:Name="Loading" Text="Cargando…" Foreground="#D0D0D0" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="24"/>

        <Border Grid.Row="1" Background="#262626" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="NameText" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InfoText" Foreground="#D0D0D0" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ExtraText" Foreground="#D0D0D0" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="◀" Style="{StaticResource BarButton}" Click="OnPrev" ToolTip="Anterior (←)" AutomationProperties.Name="Foto anterior"/>
                    <Button Content="▶" Style="{StaticResource BarButton}" Click="OnNext" ToolTip="Siguiente (→)" AutomationProperties.Name="Foto siguiente" Margin="0,0,14,0"/>
                    <Button Content="−" Style="{StaticResource BarButton}" Click="OnZoomOut" ToolTip="Alejar (−)" AutomationProperties.Name="Alejar"/>
                    <Button x:Name="ZoomText" Content="Ajustar" Style="{StaticResource BarButton}" Click="OnFit" ToolTip="Ajustar a la ventana"
                            AutomationProperties.Name="Ajustar a la ventana"/>
                    <Button Content="100 %" Style="{StaticResource BarButton}" Click="OnActual" ToolTip="Tamaño real" AutomationProperties.Name="Tamaño real, 100 por ciento"/>
                    <Button Content="+" Style="{StaticResource BarButton}" Click="OnZoomIn" ToolTip="Acercar (+)" AutomationProperties.Name="Acercar" Margin="0,0,14,0"/>
                    <Button x:Name="FullButton" Content="Pantalla completa" Style="{StaticResource BarButton}" Click="OnFull" ToolTip="Pantalla completa (F11)"/>
                    <Button x:Name="PickButton" Content="Quedarme con esta" Style="{StaticResource PrimaryButton}" Margin="8,0,6,0" Click="OnPick"
                            Visibility="Collapsed" AutomationProperties.AutomationId="PreviewPick"/>
                    <Button Content="Cerrar" Style="{StaticResource BarButton}" Click="OnClose" ToolTip="Cerrar (Esc)"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
