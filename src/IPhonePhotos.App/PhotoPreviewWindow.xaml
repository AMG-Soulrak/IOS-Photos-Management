<Window x:Class="IPhonePhotos.App.PhotoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foto" Height="860" Width="1100" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner" Background="#1F1F1F" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="14" KeyDown="OnKey">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="Big" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="Loading" Text="Cargando…" Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border Grid.Row="1" Background="#2B2B2B" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="InfoText" Foreground="#C8C8C8" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock x:Name="ScoreText" Foreground="#C8C8C8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Anterior" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnPrev"/>
                    <Button Content="Siguiente ▶" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Click="OnNext"/>
                    <Button x:Name="PickButton" Content="Quedarme con esta" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnPick"
                            AutomationProperties.AutomationId="PreviewPick"/>
                    <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
